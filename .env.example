# Application Settings
IP=127.0.0.1
PORT=5005
NODE_ENV=development
RESPONSE_MODE=STRICT

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/goconnecte

# Security & Authentication
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=your_jwt_access_secret_key
jwtRefreshSecret=your_jwt_refresh_secret_key
JWT_EXPIRE_IN=30d
JWT_REFRESH_EXPIRES_IN=30d
AUTH_API_KEY=

# Client Application
CLIENT_URL=http://localhost:3000
BASE_URL=http://localhost:5005
CURRENCY=MYR

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Background Jobs
START_CRON=true

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# CinetPay Payment Gateway
CINATPAY_SITE_ID=your_cinetpay_site_id
CINATPAY_API_KEY=your_cinetpay_api_key
CINATPAY_SECRET_KEY=your_cinetpay_secret_key

# Firebase Push Notifications & Auth
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# OAuth Authentication Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Twilio Service
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SERVICE_SID=your_twilio_service_sid

# AfrikSMS Gateway
AFRIKSMS_CLIENT_ID=your_afriksms_client_id
AFRIKSMS_API_KEY=your_afriksms_api_key
AFRIKSMS_SENDER_ID=GoConnecte
AFRIKSMS_CALLBACK_URL=http://localhost:5005/api/v1/sms-logs/afrik-sms/callback

# SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=your_email@example.com
SUPPORT_RECEIVER_EMAIL=support@example.com

# Initial Super Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_secure_password
